<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The network is used for one thing only: Android's DownloadManager
      downloading one of Akkhara's listed translation models, over Wi-Fi, at
      the app's request (docs/adr/0004, 0005 and 0006). DownloadManager needs
      the app to hold INTERNET. No code in the app opens a connection itself:
      no analytics, crash reports, cloud features or update checks
      (docs/adr/0002).
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- An import runs in the background as a foreground service, shown in a notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        tools:targetApi="s">

        <activity
            android:name=".AppActivity"
            android:exported="true"
            android:theme="@style/Theme.Akkhara"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AkkharaImeService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!--
          The translation model runs in its own process so that the memory it
          needs can never get the keyboard stopped.
        -->
        <service
            android:name=".translation.TranslatorService"
            android:exported="false"
            android:process=":translator" />

        <service
            android:name=".translation.ModelImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Android says when a model download is over, even while the app is
          not running. Only the download provider can send this.
        -->
        <receiver
            android:name=".translation.ModelDownloadReceiver"
            android:exported="true"
            android:permission="android.permission.SEND_DOWNLOAD_COMPLETED_INTENTS">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- Checks a model Android has finished downloading. -->
        <service
            android:name=".translation.ModelCheckJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- The GPU backend of the translation model uses OpenCL where the phone has it. -->
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />

    </application>

</manifest>
